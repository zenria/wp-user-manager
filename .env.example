# WordPress site (no trailing slash)
WP_URL=https://example.com
# Login of the account owning the application password
WP_USER=admin
# Users > Profile > Application Passwords (spaces are ignored)
WP_APP_PASSWORD="abcd efgh ijkl mnop qrst uvwx"
# Reference file: one identity per line
WP_REFERENCE_FILE=./users.txt

# Optional
# WP_DEFAULT_ROLE=subscriber
# WP_PROTECTED_EMAILS=owner@example.com,billing@example.com
# WP_STRIP_PLUS_TAGS=true
# WP_DELETE_ADMINISTRATORS=false
# WP_REASSIGN_TO=1
# WP_TIMEOUT_SECONDS=30
# WP_ASSUME_YES=false
